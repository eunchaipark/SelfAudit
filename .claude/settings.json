{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./backups/**)",
      "Read(./secrets/**)",
      "Read(~/AppData/Local/SelfAudit/**)",
      "Read(./**/local.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/ops/scripts/hook_compact.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/ops/scripts/hook_fence.py\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
