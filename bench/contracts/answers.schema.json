{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selfaudit-bench/answers@1",
  "title": "정답지 (bench/answers/<번들 ID>.json)",
  "description": "docs/설계/실험구조.md 2.2절. 값마다 근거는 그 절에 있다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "origin", "difficulty", "bundle_manifest_sha256", "complete", "items", "decoys"],
  "$defs": {
    "category": {
      "enum": [
        "secret",
        "source_map",
        "internal_address",
        "admin_path",
        "hidden_route",
        "client_authz",
        "debug_flag",
        "vulnerable_library"
      ]
    },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "relpath": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!\\.?/)(?!.*\\\\)(?!(.*/)?\\.\\.?(/|$)).+$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line_start", "line_end"],
      "properties": {
        "file": { "$ref": "#/$defs/relpath" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "anchor": { "type": ["string", "null"], "minLength": 4, "maxLength": 200 }
  },
  "properties": {
    "schema": { "const": "selfaudit-bench/answers@1" },
    "bundle_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
    "origin": { "enum": ["planted", "practice"] },
    "difficulty": { "$ref": "#/$defs/difficulty" },
    "bundle_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "complete": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categories", "difficulty", "hiding", "locations", "anchor", "planted", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,30}$" },
          "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/category" } },
          "difficulty": { "$ref": "#/$defs/difficulty" },
          "hiding": { "enum": ["plain", "split", "encoded", "obfuscated", "sourcemap_only", "comment", "config", "none"] },
          "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
          "anchor": { "$ref": "#/$defs/anchor" },
          "planted": { "type": "string", "minLength": 1, "maxLength": 500 },
          "why": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "decoys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locations", "anchor", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,30}$" },
          "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
          "anchor": { "$ref": "#/$defs/anchor" },
          "why": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
