{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selfaudit-bench/targets@1",
  "title": "대상 목록 (bench/targets.json, 저장소 밖 내 앱 목록 %LOCALAPPDATA%\\SelfAudit-private\\targets.json도 같은 꼴)",
  "description": "docs/설계/실험구조.md 2.10절, 기능명세 F-B05. 뜻 규칙(ID 고유, 종류마다 경로 꼴)은 bench/common/contracts.py check_targets_semantics. 저장소 안 목록에 mine이 없는지는 검사 '실험자료'(check_bench.py)가 본다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "targets"],
  "properties": {
    "schema": { "const": "selfaudit-bench/targets@1" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "bundle", "answers"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
          "kind": { "enum": ["planted", "practice", "mine"] },
          "bundle": { "type": "string", "minLength": 1, "maxLength": 300 },
          "answers": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
