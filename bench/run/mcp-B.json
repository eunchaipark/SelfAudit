{
  "mcpServers": {
    "rea": {
      "command": "<PYTHON>",
      "args": [
        "-I",
        "<ROOT>\\bench\\run\\rea_mcp_filter.py",
        "--allow",
        "analyze_javascript_application,audit_release_exposure,trace_javascript_semantics,trace_application_feature",
        "--target",
        "<RUN>\\target",
        "--netguard-log",
        "<RUN>\\netguard.jsonl",
        "--env-dir",
        "<RUN>\\rea-env",
        "--",
        "<ROOT>\\.tools\\node\\node.exe",
        "<ROOT>\\.tools\\rea\\node_modules\\rea-agents\\scripts\\rea.mjs",
        "mcp"
      ],
      "env": {
        "REA_MCP_TOOL_FAMILIES": "electron,artifact,application"
      }
    }
  }
}
